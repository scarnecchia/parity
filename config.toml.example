# Copy to config.toml and run: parity run --config config.toml.
# Relative paths here resolve from this file's directory; ~ expands.
# Environment variables are not interpolated. CLI options override individual keys.

# Required string path: SAS output root containing dplocal/ and msoc/. No default.
sas_root = "../sas-output"

# Required string path: Parquet output root containing dplocal/ and msoc/. No default.
python_root = "../parquet-output"

# Optional string path: report directory, which must be absent or empty.
# Default: "./parity-report" in the working directory when this key is omitted.
output_dir = "./parity-report"

# Optional string path: per-table schema file mapping table names to settings
# such as pair_keys (see schema.toml.example).
# schema = "schema.toml"

# Optional string: request id written as a subfolder of the report directory, so
# one report directory can hold many runs. Letters, numbers, and underscores only,
# at most 64 characters; the reserved report name "details" is rejected.
# Default: unset, writing the report directly into the report directory.
# id = "run_001"

# Optional string: DuckDB memory limit. Default: "1GB".
memory_limit = "1GB"

# Optional string path: existing base directory for the run's private temporary directory.
# Default: unset, using Python's system temporary-directory selection (including TMPDIR).
# Keep it outside both input roots. Uncomment to choose a base directory.
# temp_dir = "../parity-temp"

# Optional string: DuckDB maximum temporary-directory size. Default: "10GB".
max_temp_size = "10GB"

# Optional nonnegative integer: flat difference rows shown per dataset in HTML.
# Default: 100. Set to 0 to omit table rows. Complete JSONL v2 details remain available.
preview_rows = 100

# Optional positive integer preview limits. Defaults: 1 MiB per dataset, 10 MiB per run, 512 characters per cell.
preview_max_bytes = 1048576
preview_total_max_bytes = 10485760
preview_cell_chars = 512

# Optional list of shared column names used as join keys: both tables are
# ordered by these columns and each row is compared only with the row whose
# key values are equal; rows with no key match are listed one-sided. Remaining
# shared columns order rows within equal keys. Column names are case-folded to
# match staged columns; keys missing from a dataset's shared columns are
# reported in run.jsonl and dropped. Declare the stable identity columns, not
# columns whose values may be corrupted.
# Default: unset; excess rows pair by ascending value order across all
# shared columns.
pair_keys = ["group", "person_id"]

# Per-table pairing keys override this global default for the named table;
# see schema.toml.example and the --schema option.

# Optional automatic Excel workbook. A limit breach omits the complete workbook.
# Defaults: enabled, 100 sheets, 100000 difference rows total, 25000 per dataset, 100 MiB projected uncompressed cell text.
excel = true
excel_max_sheets = 100
excel_max_rows = 100000
excel_max_rows_per_sheet = 25000
excel_max_bytes = 104857600

# Optional positive integer: DuckDB worker threads for comparison.
# Default: 4.
threads = 4
